local function AddToggle(name, modTable, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 28)
    btn.Position = UDim2.new(0, 10, 0, 30 + (#Main:GetChildren() - 3) * 32)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    btn.Text = name .. ": OFF"
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 12
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.BorderSizePixel = 0
    btn.Parent = Main

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 4)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        modTable[key or "Enabled"] = not modTable[key or "Enabled"]
        btn.Text = name .. ": " .. (modTable[key or "Enabled"] and "ON" or "OFF")
        btn.BackgroundColor3 = modTable[key or "Enabled"] and Color3.fromRGB(40, 60, 40) or Color3.fromRGB(25, 25, 32)
    end)
end

